# ═══════════════════════════════════════════════════════════════════════
# VARIABLES DE ENTORNO 
# ═══════════════════════════════════════════════════════════════════════

# ── APLICACIÓN ──────────────────────────────────────────────────────────
NODE_ENV=development          # Entorno: development | production | test
PORT=3000                     # Puerto donde escucha la API
APP_NAME="NestJS Learning"    # Nombre de la aplicación (aparece en Swagger)
API_PREFIX=api                # Prefijo global de rutas: /api/v1/users

# ── BASE DE DATOS (PostgreSQL) ───────────────────────────────────────────
# Estos valores deben coincidir con los de docker-compose.yml
DB_HOST=localhost              # Host de PostgreSQL (en Docker: postgres)
DB_PORT=5432                  # Puerto por defecto de PostgreSQL
DB_USERNAME=nestuser           # Usuario de la base de datos
DB_PASSWORD=nestpassword       # Contraseña (usa algo fuerte en producción)
DB_DATABASE=nestdb             # Nombre de la base de datos
DB_SYNCHRONIZE=true            # Solo en desarrollo: sincroniza entidades automáticamente
DB_LOGGING=true                # Loguea las queries SQL en consola (útil para aprender)
DB_SSL=false                   # SSL: false local, true en producción (RDS, Heroku, etc.)

# ── REDIS (Cache) ────────────────────────────────────────────────────────
REDIS_HOST=localhost           # Host de Redis (en Docker: redis)
REDIS_PORT=6379                # Puerto por defecto de Redis
REDIS_PASSWORD=                # Contraseña de Redis (vacía = sin contraseña)
REDIS_TTL=300                  # TTL por defecto del cache en segundos (5 minutos)
REDIS_DB=0                     # Base de datos de Redis (0-15)

# ── JWT  ──────────────────────────────
JWT_SECRET=tu-secreto-super-seguro-cambiar-en-produccion
JWT_EXPIRES_IN=7d              # Tiempo de expiración del token: 7d, 1h, 30m

# ── PGADMIN (Interfaz web de PostgreSQL) ─────────────────────────────────
PGADMIN_EMAIL=admin@admin.com  # Email para entrar a pgAdmin (http://localhost:5050)
PGADMIN_PASSWORD=admin         # Contraseña de pgAdmin

# ── THROTTLE (Rate limiting) ─────────────────────────────────────────────
THROTTLE_TTL=60                # Ventana de tiempo en segundos
THROTTLE_LIMIT=100             # Máximo de requests por ventana

# ── CORS ─────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:4200
